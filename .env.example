# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Never commit the real .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: phone notifications ("Get alerts on this device"). The PUBLIC notification
# key only - see README.md -> "Phone alerts" for how to make the keys. The private key
# and the Supabase service role key go in Vercel only, never in this file.
VITE_VAPID_PUBLIC_KEY=

# The tracker's emergency call (api/emergency-call.ts), from your Twilio account
# (console.twilio.com -> Account info). Leave them out and the alert makes a pretend call.
# Phone numbers: + country code, no spaces. On a free trial, ALERT_CALL_TO must be verified in Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+15551234567
ALERT_CALL_TO=+15557654321
ALERT_PERSON_NAME=Grandma
