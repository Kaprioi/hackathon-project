# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Never commit the real .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: phone notifications ("Get alerts on this device"). The PUBLIC notification
# key only - see README.md -> "Phone alerts" for how to make the keys. The private key
# and the Supabase service role key go in Vercel only, never in this file.
VITE_VAPID_PUBLIC_KEY=

# The tracker's emergency call (api/emergency-call.ts), from your Twilio account
# (console.twilio.com -> Account info). Leave them out and the alert makes a pretend call.
# Phone numbers: + country code, no spaces. The number to call is typed on the camera phone
# (/tracker -> Settings -> Emergency alert). ALERT_CALL_TO is optional: called when Settings has
# no number. On a free trial, every number called must be verified in Twilio first.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+15551234567
# ALERT_CALL_TO=+15557654321
ALERT_PERSON_NAME=Grandma

# Optional: Gemini's look at the picture when an alert's countdown runs out (api/scene-check.ts).
# A key from Google AI Studio (aistudio.google.com -> Get API key). Server only, never in the page.
# Leave it out and the call goes ahead without a description. On the free tier Google may keep
# and review the pictures, so real use needs the paid tier. GEMINI_MODEL is optional.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
